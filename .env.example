# Copy to .env and fill in to connect real services.
# The app runs fully on mock data without any of these.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

VITE_GOOGLE_MAPS_API_KEY=
VITE_GEMINI_API_KEY=

# Report photo/video hosting — Cloudinary free tier (no card required),
# used instead of Firebase Storage since Storage now requires the paid
# Blaze plan even for near-zero usage. See GO_LIVE_GUIDE.md.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

VITE_API_BASE_URL=http://localhost:8000
